# Copy to .env and fill values. Never commit the real .env.
# Generate the Ed25519 credentials at https://polymarket.us/developer after KYC.

# Polymarket US API credentials
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Anthropic API key for the Claude sanity-check veto layer
ANTHROPIC_API_KEY=

# Optional. Defaults to config/default.toml when unset.
POLYBOT_CONFIG=config/default.toml
